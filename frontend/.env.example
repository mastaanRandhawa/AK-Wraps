# Copy this file to `.env.local` and fill in your values.
# `.env.local` is gitignored — never commit real keys.

# Contact form delivery (https://web3forms.com — free, no backend).
# Create an access key with your inbox email, then paste it here.
# If left blank, the contact form falls back to opening the visitor's mail client.
VITE_WEB3FORMS_KEY=

# Optional: override the hero background video URL (defaults to /videos/hero.mp4).
# VITE_HERO_VIDEO_URL=
